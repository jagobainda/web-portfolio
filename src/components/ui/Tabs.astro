---
interface Tab {
    id: string;
    label: string;
}

interface Props {
    tabs: Tab[];
    name: string;
    class?: string;
}

const { tabs, name, class: className } = Astro.props;
---

<div class:list={["tabs-container", className]} data-tabs={name}>
    <div
        role="tablist"
        class:list={[
            "tab-buttons flex flex-wrap justify-center",
            "mb-6 border-b border-(--bg-secondary)",
            "max-sm:mb-3 max-sm:flex-nowrap max-sm:justify-start max-sm:gap-0 max-sm:overflow-x-auto max-sm:pb-1",
        ]}
    >
        {
            tabs.map((tab, index) => (
                <button
                    type="button"
                    role="tab"
                    id={`tab-${name}-${tab.id}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    aria-controls={`${name}-${tab.id}`}
                    tabindex={index === 0 ? 0 : -1}
                    class:list={[
                        "tab-btn cursor-pointer border-none bg-transparent",
                        "mx-2 px-6 py-3 font-mono text-base",
                        "text-text-color border-b-2 border-transparent",
                        "transition-all duration-300 ease-in-out",
                        "hover:border-b-bg-secondary",
                        "max-md:px-4 max-md:py-2 max-md:text-sm",
                        "max-sm:mx-0.5 max-sm:px-2 max-sm:py-1.5 max-sm:text-xs max-sm:whitespace-nowrap",
                        index === 0 && "active",
                    ]}
                    data-target={`${name}-${tab.id}`}
                >
                    {tab.label}
                </button>
            ))
        }
    </div>

    <div class="tab-panels p-3">
        {
            tabs.map(async (tab, index) => (
                <div
                    id={`${name}-${tab.id}`}
                    role="tabpanel"
                    aria-labelledby={`tab-${name}-${tab.id}`}
                    tabindex="0"
                    class:list={["tab-panel focus:outline-none", index !== 0 && "hidden"]}
                >
                    <Fragment set:html={await Astro.slots.render(tab.id)} />
                </div>
            ))
        }
    </div>
</div>

<style>
    .tab-btn.active {
        border-bottom-color: var(--text-color);
        font-weight: bold;
    }

    @media (max-width: 480px) {
        .tab-buttons::-webkit-scrollbar {
            height: 3px;
        }
        .tab-buttons::-webkit-scrollbar-thumb {
            background: var(--bg-secondary);
        }
    }
</style>
