---
import { Icon } from "astro-icon/components";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<button
    id="theme-toggle"
    aria-label="Toggle theme"
    class:list={[
        "flex items-center justify-center",
        "h-13.75 w-13.75 cursor-pointer rounded-md border-none",
        "text-text-color bg-(--bg-secondary)",
        "shadow-[4px_4px_6px_var(--shadow-light)]",
        "transition-all duration-300 ease-in-out",
        "hover:shadow-[6px_6px_8px_var(--shadow-dark)]",
        "max-md:h-11.25 max-md:w-11.25",
        className,
    ]}
>
    <Icon
        name="bi:moon-stars-fill"
        id="theme-icon-dark"
        class="text-text-color text-xl transition-colors duration-300"
    />
    <Icon name="bi:sun-fill" id="theme-icon-light" class="text-text-color text-xl transition-colors duration-300" />
</button>

<style is:global>
    /* Default theme is dark, so the dark-state icon is visible by default. */
    #theme-icon-light {
        display: none;
    }
    #theme-icon-dark {
        display: inline-block;
    }
    body:not(.dark) #theme-icon-dark {
        display: none;
    }
    body:not(.dark) #theme-icon-light {
        display: inline-block;
    }
</style>
