---
interface Props {
    id?: string;
    icon: string;
    text?: string;
    variant?: "main" | "control";
    ariaLabel?: string;
    class?: string;
}

const { id, icon, text, variant = "main", ariaLabel, class: className } = Astro.props;
const isMain = variant === "main";
---

{
    isMain ? (
        <button
            id={id}
            aria-label={ariaLabel}
            class:list={[
                "btn-main group relative flex flex-col items-center justify-center gap-5 overflow-hidden",
                "h-75 min-h-20 w-1/5 min-w-62.5",
                "cursor-pointer rounded-xl border-none bg-(--bg-secondary)",
                "text-text-color transition-all duration-300 ease-in-out",
                "shadow-[4px_4px_8px_var(--shadow-light)]",
                "hover:-translate-y-1.25 hover:shadow-[6px_6px_12px_var(--shadow-dark)]",
                "max-md:h-45 max-md:w-[45%] max-md:min-w-0",
                "max-sm:h-15 max-sm:w-full max-sm:flex-row max-sm:justify-start max-sm:gap-0 max-sm:pl-5",
                className,
            ]}
        >
            <i
                aria-hidden="true"
                class:list={[icon, "z-1 text-[3.5rem]", "max-md:text-[2.5rem]", "max-sm:mr-4 max-sm:text-[1.8rem]"]}
            />
            {text && (
                <span class:list={["z-1 font-mono text-2xl font-bold", "max-md:text-xl", "max-sm:text-lg"]}>
                    {text}
                </span>
            )}
        </button>
    ) : (
        <button
            id={id}
            aria-label={ariaLabel}
            class:list={[
                "btn-control flex items-center justify-center",
                "h-13.75 w-13.75 cursor-pointer rounded-md border-none",
                "text-text-color bg-(--bg-secondary)",
                "shadow-[4px_4px_6px_var(--shadow-light)]",
                "transition-all duration-300 ease-in-out",
                "hover:shadow-[6px_6px_8px_var(--shadow-dark)]",
                "max-md:h-11.25 max-md:w-11.25",
                className,
            ]}
        >
            <i aria-hidden="true" class={`${icon} text-xl`} />
        </button>
    )
}
