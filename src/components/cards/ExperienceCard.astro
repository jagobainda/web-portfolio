---
interface Props {
    position: string;
    company: string;
    location: string;
    period: string;
    responsibilities: string[];
    technologies: string[];
    icon: string;
    responsibilitiesLabel: string;
    technologiesLabel: string;
}

const {
    position,
    company,
    location,
    period,
    responsibilities,
    technologies,
    icon,
    responsibilitiesLabel,
    technologiesLabel,
} = Astro.props;
---

<div
    class:list={[
        "rounded-lg bg-(--bg-secondary) p-6",
        "shadow-[0_3px_8px_var(--shadow-light)]",
        "transition-all duration-200",
        "hover:-translate-y-0.5 hover:shadow-[0_5px_15px_var(--shadow-dark)]",
        "max-md:p-4",
    ]}
>
    <div class:list={["mb-4 flex gap-4", "max-md:flex-col max-md:items-start max-md:gap-2"]}>
        <div
            class:list={[
                "h-12.5 w-12.5 rounded-full bg-(--bg-primary)",
                "flex shrink-0 items-center justify-center",
                "max-md:h-10 max-md:w-10",
            ]}
        >
            <i class={`${icon} text-2xl text-text-color max-md:text-xl`}></i>
        </div>

        <div class="flex-1">
            <h3 class="m-0 mb-1 font-mono text-xl max-md:text-lg">{position}</h3>
            <div class="mb-1 flex flex-wrap items-center justify-between">
                <span class="mr-2 font-bold">{company}</span>
                <span class="text-sm opacity-80">{location}</span>
            </div>
            <div class="text-sm italic opacity-70">{period}</div>
        </div>
    </div>

    {
        responsibilities.length > 0 && (
            <div class="mb-4">
                <h4 class="my-2 font-mono text-base">{responsibilitiesLabel}</h4>
                <ul class="my-2 list-disc pl-6">
                    {responsibilities.map(resp => (
                        <li class="mb-1 text-sm leading-relaxed">{resp}</li>
                    ))}
                </ul>
            </div>
        )
    }

    {
        technologies.length > 0 && (
            <div>
                <h4 class="my-2 font-mono text-base">{technologiesLabel}</h4>
                <div class="mt-4 flex flex-wrap gap-3 max-md:gap-2">
                    {technologies.map(tech => (
                        <span
                            class:list={[
                                "rounded-full bg-(--bg-primary) px-3 py-1.5 text-sm",
                                "flex items-center",
                                "max-md:px-2.5 max-md:py-1 max-md:text-xs",
                            ]}
                        >
                            <i class="bi bi-check-circle-fill mr-1.5 text-xs text-green-500" />
                            {tech}
                        </span>
                    ))}
                </div>
            </div>
        )
    }
</div>
