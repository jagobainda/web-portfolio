---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { projectStructuredData } from "../../lib/seo";

interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;
const homeUrl = lang === "en" ? "/en" : "/";

const projectsEntry = await getEntry("projects", lang);
const projects = projectsEntry!.data;
const portfolioProject = projects.personal.find(
    p => p.name === "Interactive Portfolio" || p.name === "Portfolio Interactivo",
);

const contentEntry = await getEntry("project-details", `web-portfolio-${lang}`);
const t = contentEntry!.data;

const jsonLd = projectStructuredData({
    lang,
    slug: "web-portfolio",
    name: t.title,
    description: t.description!,
    sourceUrl: "https://github.com/jagobainda/web-portfolio",
});
---

<BaseLayout title={`${t.title} - Jagoba Inda`} description={t.description!} showContactButton={false} jsonLd={jsonLd}>
    <div
        class:list={[
            "bg-bg-primary min-h-screen w-full",
            "transition-colors duration-300",
            "px-8 py-20",
            "max-sm:px-4 max-sm:py-16",
        ]}
    >
        <div class="mx-auto max-w-5xl">
            <a
                href={homeUrl}
                class:list={[
                    "mb-8 inline-flex items-center gap-2",
                    "text-text-color no-underline",
                    "transition-opacity duration-300 hover:opacity-70",
                    "font-mono text-lg",
                ]}
            >
                {t.backButton}
            </a>

            <div
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-10",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <div class="mb-4 flex items-center gap-4">
                    <div
                        class:list={[
                            "h-16 w-16 rounded-xl",
                            "bg-linear-to-br from-purple-500 to-pink-500",
                            "flex items-center justify-center",
                            "shadow-lg",
                        ]}
                    >
                        <i class="bi bi-code-slash text-3xl text-white"></i>
                    </div>
                    <div>
                        <h1
                            class:list={[
                                "font-mono text-4xl font-bold",
                                "text-text-color",
                                "transition-colors duration-300",
                                "max-sm:text-2xl",
                            ]}
                        >
                            {t.title}
                        </h1>
                        <p class="font-mono text-lg opacity-70">{t.subtitle}</p>
                    </div>
                </div>
                <p class:list={["mt-6 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.description}
                </p>

                <div class="mt-6 flex flex-wrap gap-4">
                    {
                        portfolioProject?.links.map(link => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class:list={[
                                    "inline-flex items-center gap-2",
                                    "rounded-lg bg-(--bg-primary) px-5 py-3",
                                    "text-text-color font-mono no-underline",
                                    "hover:-translate-y-1 hover:shadow-[0_6px_12px_var(--shadow-dark)]",
                                    "transition-all duration-300",
                                ]}
                            >
                                <i class={link.icon} />
                                {link.text}
                            </a>
                        ))
                    }
                </div>
            </div>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <i class="bi bi-stack text-2xl text-blue-500"></i>
                    {t.techStack}
                </h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-orange-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <i class="bi bi-rocket-takeoff text-2xl text-orange-500"></i>
                            <span class="font-mono text-lg font-bold">Astro</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techAstro}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-blue-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <i class="bi bi-filetype-tsx text-2xl text-blue-500"></i>
                            <span class="font-mono text-lg font-bold">TypeScript</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techTypeScript}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-cyan-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <i class="bi bi-wind text-2xl text-cyan-500"></i>
                            <span class="font-mono text-lg font-bold">Tailwind CSS</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techTailwind}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-pink-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <i class="bi bi-play-circle text-2xl text-pink-500"></i>
                            <span class="font-mono text-lg font-bold">anime.js</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techAnime}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-purple-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <i class="bi bi-shield-check text-2xl text-purple-500"></i>
                            <span class="font-mono text-lg font-bold">Zod</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techZod}</p>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <i class="bi bi-diagram-3 text-2xl text-green-500"></i>
                    {t.architecture}
                </h2>
                <p class:list={["mb-8 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.architectureDesc}
                </p>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                        <div
                            class:list={[
                                "rounded-xl bg-(--bg-primary) p-5 text-center",
                                "border-t-4 border-orange-500",
                            ]}
                        >
                            <i class="bi bi-file-earmark-code mb-2 text-3xl text-orange-500"></i>
                            <div class="font-mono font-bold">{t.archAstroPages}</div>
                            <div class="mt-1 text-sm opacity-70">{t.archAstroPagesDesc}</div>
                        </div>
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-blue-500"]}
                        >
                            <i class="bi bi-collection mb-2 text-3xl text-blue-500"></i>
                            <div class="font-mono font-bold">{t.archContentCollections}</div>
                            <div class="mt-1 text-sm opacity-70">{t.archContentCollectionsDesc}</div>
                        </div>
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-cyan-500"]}
                        >
                            <i class="bi bi-brush mb-2 text-3xl text-cyan-500"></i>
                            <div class="font-mono font-bold">{t.archTailwindStyles}</div>
                            <div class="mt-1 text-sm opacity-70">{t.archTailwindStylesDesc}</div>
                        </div>
                    </div>

                    <div class="flex justify-center py-2">
                        <div class:list={["flex flex-col items-center", "text-text-color opacity-70"]}>
                            <i class="bi bi-arrow-down text-3xl"></i>
                        </div>
                    </div>

                    <div class="flex justify-center">
                        <div
                            class:list={[
                                "w-full rounded-xl bg-(--bg-primary) p-6 text-center md:w-2/3",
                                "border-t-4 border-purple-500",
                            ]}
                        >
                            <i class="bi bi-lightning-charge mb-2 text-3xl text-purple-500"></i>
                            <div class="font-mono font-bold">{t.archHybridRendering}</div>
                            <div class="mt-1 text-sm opacity-70">{t.archHybridRenderingDesc}</div>
                        </div>
                    </div>

                    <div class="flex justify-center py-2">
                        <div class:list={["flex flex-col items-center", "text-text-color opacity-70"]}>
                            <i class="bi bi-arrow-down text-3xl"></i>
                        </div>
                    </div>

                    <div class="flex justify-center">
                        <div
                            class:list={[
                                "w-full rounded-xl bg-(--bg-primary) p-6 text-center md:w-2/3",
                                "border-t-4 border-orange-400",
                            ]}
                        >
                            <i class="bi bi-shield-check mb-2 text-3xl text-orange-400"></i>
                            <div class="font-mono font-bold">{t.archCloudflare}</div>
                            <div class="mt-1 text-sm opacity-70">{t.archCloudflareDesc}</div>
                        </div>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <i class="bi bi-palette text-2xl text-pink-500"></i>
                    {t.designPhilosophy}
                </h2>
                <p class:list={["text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.designDesc}
                </p>

                <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "flex items-start gap-4"]}>
                        <i class="bi bi-bullseye text-3xl text-blue-500"></i>
                        <div>
                            <div class="mb-1 font-mono font-bold">{t.designSimplicity}</div>
                            <div class="text-sm opacity-80">{t.designSimplicityDesc}</div>
                        </div>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "flex items-start gap-4"]}>
                        <i class="bi bi-lightning-charge text-3xl text-yellow-500"></i>
                        <div>
                            <div class="mb-1 font-mono font-bold">{t.designImmediateAccess}</div>
                            <div class="text-sm opacity-80">{t.designImmediateAccessDesc}</div>
                        </div>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <i class="bi bi-gear text-2xl text-green-500"></i>
                    {t.stackPhilosophy}
                </h2>
                <p class:list={["text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.stackDesc}
                </p>

                <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5 text-center"]}>
                        <i class="bi bi-speedometer2 mb-2 text-2xl text-orange-500"></i>
                        <div class="font-mono font-bold">{t.stackPerformance}</div>
                        <div class="mt-1 text-sm opacity-70">{t.stackPerformanceDesc}</div>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5 text-center"]}>
                        <i class="bi bi-code-slash mb-2 text-2xl text-blue-500"></i>
                        <div class="font-mono font-bold">{t.stackDX}</div>
                        <div class="mt-1 text-sm opacity-70">{t.stackDXDesc}</div>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5 text-center"]}>
                        <i class="bi bi-brush mb-2 text-2xl text-cyan-500"></i>
                        <div class="font-mono font-bold">{t.stackStyles}</div>
                        <div class="mt-1 text-sm opacity-70">{t.stackStylesDesc}</div>
                    </div>
                </div>
            </section>

            <div class="mt-12 text-center">
                <a
                    href="mailto:contact@jagoba.dev"
                    class:list={["text-text-color opacity-50", "transition-opacity hover:opacity-100", "no-underline"]}
                >
                    contact@jagoba.dev
                </a>
            </div>
        </div>
    </div>
</BaseLayout>
