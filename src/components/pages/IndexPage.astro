---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../ui/Button.astro";
import ContactModal from "../sections/ContactModal.astro";
import ProjectsModal from "../sections/ProjectsModal.astro";
import TechnologiesModal from "../sections/TechnologiesModal.astro";
import ExperienceModal from "../sections/ExperienceModal.astro";
import AboutMeModal from "../sections/AboutMeModal.astro";
import { getEntry } from "astro:content";

interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;

const uiEntry = await getEntry("ui", lang);
const ui = uiEntry!.data;
---

<BaseLayout title="Jagoba Inda - Full Stack Developer" description={ui.seo.homeDescription}>
    <main
        id="app"
        class:list={[
            "bg-bg-primary h-screen w-screen",
            "flex flex-col items-center justify-center gap-11",
            "transition-colors duration-300",
            "max-lg:gap-7",
            "max-md:gap-6",
            "max-sm:box-border max-sm:h-screen max-sm:justify-center max-sm:gap-3 max-sm:overflow-hidden max-sm:px-4 max-sm:pt-14 max-sm:pb-4",
        ]}
    >
        <h1
            id="welcome-title"
            class:list={[
                "m-0 text-center font-mono font-bold",
                "text-text-color text-[5rem]",
                "transition-[color,text-shadow] duration-300 ease-in-out",
                "[text-shadow:3px_3px_5px_var(--shadow-light)]",
                "dark:[text-shadow:3px_3px_6px_var(--shadow-dark)]",
                "min-[2304px]:text-[6rem]",
                "max-[1109px]:min-[769px]:text-[4.5rem]",
                "max-[768px]:min-[481px]:text-[3.5rem]",
                "max-[480px]:-mt-15 max-[480px]:mb-5 max-[480px]:text-[2rem]",
                "landscape:max-h-[480px]:text-[2.2rem] landscape:max-h-[480px]:mb-2.5 landscape:max-h-[480px]:mt-0",
            ]}
        >
        </h1>

        <div
            class:list={[
                "flex w-full items-center justify-center gap-6",
                "max-[900px]:w-[90%] max-[900px]:max-w-175 max-[900px]:flex-wrap max-[900px]:gap-4",
                "max-sm:mt-0 max-sm:w-[90%] max-sm:flex-col max-sm:gap-2.5",
            ]}
        >
            <Button id="btn-projects" icon="bi bi-code-square" text={ui.buttons.projects} />
            <Button id="btn-technologies" icon="bi bi-tools" text={ui.buttons.technologies} />
            <Button id="btn-experience" icon="bi bi-briefcase" text={ui.buttons.experience} />
            <Button id="btn-about-me" icon="bi bi-person" text={ui.buttons.aboutMe} />
        </div>
    </main>

    <ContactModal
        title={ui.contactTitle}
        emailText={ui.emailText}
        linkedinText={ui.linkedinText}
        githubText={ui.githubText}
        resumeText={ui.resumeText}
    />

    <ProjectsModal title={ui.projectsTitle} lang={lang} />

    <TechnologiesModal title={ui.technologiesTitle} tabLabels={ui.techTabs} />

    <ExperienceModal title={ui.experienceTitle} lang={lang} />

    <AboutMeModal title={ui.aboutMeTitle} lang={lang} />
</BaseLayout>
