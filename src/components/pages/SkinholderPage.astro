---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { projectStructuredData } from "../../lib/seo";

interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;
const homeUrl = lang === "en" ? "/en" : "/";

const projectsEntry = await getEntry("projects", lang);
const projects = projectsEntry!.data;
const skinholderProjects = projects.personal.filter(p => p.name.includes("SkinHolder"));

const contentEntry = await getEntry("project-details", `skinholder-${lang}`);
const t = contentEntry!.data;

const jsonLd = projectStructuredData({
    lang,
    slug: "skinholder",
    name: t.title,
    description: t.whatIsDescription!,
});
---

<BaseLayout
    title={`${t.title} - Jagoba Inda`}
    description={t.whatIsDescription!}
    showContactButton={false}
    jsonLd={jsonLd}
>
    <div
        class:list={[
            "bg-bg-primary min-h-screen w-full",
            "transition-colors duration-300",
            "px-8 py-20",
            "max-sm:px-4 max-sm:py-16",
        ]}
    >
        <div class="mx-auto max-w-5xl">
            <!-- Back Button -->
            <a
                href={homeUrl}
                class:list={[
                    "mb-8 inline-flex items-center gap-2",
                    "text-text-color no-underline",
                    "transition-opacity duration-300 hover:opacity-70",
                    "font-mono text-lg",
                ]}
            >
                {t.backButton}
            </a>

            <!-- Header Section -->
            <div
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-10",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h1
                    class:list={[
                        "mb-4 font-mono text-5xl font-bold",
                        "text-text-color",
                        "transition-colors duration-300",
                        "max-sm:text-3xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:collection" />
                    {t.title}
                </h1>
                <p class:list={["text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.whatIsDescription}
                </p>
            </div>

            <!-- Features -->
            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:star" class="text-2xl" />
                    {t.features}
                </h2>
                <ul class="space-y-4">
                    <li class:list={["flex items-center gap-3", "rounded-xl bg-(--bg-primary) p-4", "text-text-color"]}>
                        <Icon name="bi:check-circle" class="text-xl text-green-500" />
                        <span class="text-lg">{t.feature1}</span>
                    </li>
                    <li class:list={["flex items-center gap-3", "rounded-xl bg-(--bg-primary) p-4", "text-text-color"]}>
                        <Icon name="bi:check-circle" class="text-xl text-green-500" />
                        <span class="text-lg">{t.feature3}</span>
                    </li>
                    <li class:list={["flex items-center gap-3", "rounded-xl bg-(--bg-primary) p-4", "text-text-color"]}>
                        <Icon name="bi:check-circle" class="text-xl text-green-500" />
                        <span class="text-lg">{t.feature5}</span>
                    </li>
                </ul>
            </section>

            <!-- Architecture -->
            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:diagram-3" class="text-2xl" />
                    {t.architecture}
                </h2>
                <p class:list={["mb-8 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.architectureDesc}
                </p>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                        <div
                            class:list={[
                                "rounded-xl bg-(--bg-primary) p-5 text-center",
                                "border-t-4 border-yellow-500",
                            ]}
                        >
                            <Icon name="bi:steam" class="mb-2 text-3xl text-yellow-500" />
                            <div class="font-mono font-bold">Steam API</div>
                        </div>
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-pink-500"]}
                        >
                            <Icon name="bi:currency-exchange" class="mb-2 text-3xl text-pink-500" />
                            <div class="font-mono font-bold">GamerPay API</div>
                        </div>
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-cyan-500"]}
                        >
                            <Icon name="bi:shop" class="mb-2 text-3xl text-cyan-500" />
                            <div class="font-mono font-bold">CSFloat API</div>
                        </div>
                    </div>

                    <div class="flex justify-center py-2">
                        <div class:list={["flex flex-col items-center", "text-text-color opacity-70"]}>
                            <Icon name="bi:arrow-down" class="text-3xl" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-blue-500"]}
                        >
                            <Icon name="bi:globe" class="mb-2 text-3xl text-blue-500" />
                            <div class="font-mono font-bold">{t.platformWeb}</div>
                            <div class="mt-1 text-sm opacity-70">React 19 - TS - Tailwind 4</div>
                        </div>
                        <div
                            class:list={[
                                "rounded-xl bg-(--bg-primary) p-5 text-center",
                                "border-t-4 border-purple-500",
                            ]}
                        >
                            <Icon name="bi:pc-display" class="mb-2 text-3xl text-purple-500" />
                            <div class="font-mono font-bold">{t.platformDesktop}</div>
                            <div class="mt-1 text-sm opacity-70">WPF + .NET 10</div>
                        </div>
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-green-500"]}
                        >
                            <Icon name="bi:phone" class="mb-2 text-3xl text-green-500" />
                            <div class="font-mono font-bold">{t.platformMobile}</div>
                            <div class="mt-1 text-sm opacity-70">Kotlin - Android</div>
                        </div>
                    </div>

                    <div class="flex justify-center py-2">
                        <div class:list={["flex flex-col items-center", "text-text-color opacity-70"]}>
                            <Icon name="bi:arrow-down-up" class="text-3xl" />
                        </div>
                    </div>

                    <div class="flex justify-center">
                        <div
                            class:list={[
                                "w-full rounded-xl bg-(--bg-primary) p-6 text-center md:w-2/3",
                                "border-t-4 border-orange-500",
                            ]}
                        >
                            <Icon name="bi:hdd-stack" class="mb-2 text-3xl text-orange-500" />
                            <div class="font-mono font-bold">SkinHolder API</div>
                            <div class="mt-1 text-sm opacity-70">ASP.NET Core 10</div>
                        </div>
                    </div>

                    <div class="flex justify-center py-2">
                        <div class:list={["flex flex-col items-center", "text-text-color opacity-70"]}>
                            <Icon name="bi:arrow-down-up" class="text-3xl" />
                        </div>
                    </div>

                    <div class="flex justify-center">
                        <div
                            class:list={[
                                "w-full rounded-xl bg-(--bg-primary) p-6 text-center md:w-2/3",
                                "border-t-4 border-red-500",
                            ]}
                        >
                            <Icon name="bi:database" class="mb-2 text-3xl text-red-500" />
                            <div class="font-mono font-bold">Database</div>
                            <div class="mt-1 text-sm opacity-70">MySQL 8</div>
                        </div>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:collection" class="text-2xl" />
                    {t.platforms}
                </h2>
                <div class="space-y-4">
                    {
                        skinholderProjects.map(project => (
                            <div class:list={["rounded-xl bg-(--bg-primary) p-6", "border-l-4 border-blue-500"]}>
                                <h3 class="mb-2 font-mono text-xl font-bold">{project.name}</h3>
                                <p class="text-text-color mb-4 opacity-80">{project.description}</p>
                                <div class="mb-4 flex flex-wrap gap-2">
                                    {project.tags.map(tag => (
                                        <span
                                            class:list={[
                                                "rounded-full bg-(--bg-secondary) px-3 py-1",
                                                "font-mono text-sm",
                                            ]}
                                        >
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                                <div class="flex flex-wrap gap-3">
                                    {project.links.map(link => (
                                        <a
                                            href={link.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class:list={[
                                                "inline-flex items-center gap-2",
                                                "rounded-lg bg-(--bg-secondary) px-4 py-2",
                                                "text-text-color font-mono text-sm no-underline",
                                                "hover:-translate-y-1 hover:shadow-[0_4px_8px_var(--shadow-dark)]",
                                                "transition-all duration-300",
                                            ]}
                                        >
                                            <Icon name={link.icon} />
                                            {link.text}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <div class="mt-12 space-y-6 text-center">
                <div class="flex justify-center gap-8 text-sm">
                    <a
                        href="https://jagoba.dev"
                        class:list={[
                            "text-text-color opacity-70",
                            "transition-opacity hover:opacity-100",
                            "no-underline",
                        ]}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t.madeBy}
                    </a>
                    <a
                        href="mailto:skinholder@jagoba.dev"
                        class:list={[
                            "text-text-color opacity-50",
                            "transition-opacity hover:opacity-100",
                            "no-underline",
                        ]}
                    >
                        skinholder@jagoba.dev
                    </a>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
