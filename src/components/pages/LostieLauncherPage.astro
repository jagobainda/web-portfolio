---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

interface Props {
    lang: 'en' | 'es';
}

const { lang } = Astro.props;
const homeUrl = lang === 'en' ? '/en' : '/';

const contentEntry = await getEntry('project-details', `lostie-launcher-${lang}`);
const t = contentEntry!.data;
---

<BaseLayout title={`${t.title} - Jagoba Inda`} description={t.description!} showContactButton={false}>
    <div class:list={[
        'bg-bg-primary min-h-screen w-full',
        'transition-colors duration-300',
        'py-20 px-8',
        'max-sm:py-16 max-sm:px-4'
    ]}>
        <div class="max-w-5xl mx-auto">
            <a
                href={homeUrl}
                class:list={[
                    'inline-flex items-center gap-2 mb-8',
                    'text-text-color no-underline',
                    'hover:opacity-70 transition-opacity duration-300',
                    'font-mono text-lg'
                ]}
            >
                {t.backButton}
            </a>

            <div class:list={[
                'bg-(--bg-secondary) rounded-2xl p-10 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <div class="flex items-center gap-4 mb-4">
                    <div class:list={[
                        'w-16 h-16 rounded-xl',
                        'bg-linear-to-br from-orange-500 to-red-500',
                        'flex items-center justify-center',
                        'shadow-lg'
                    ]}>
                        <i class="bi bi-controller text-3xl text-white"></i>
                    </div>
                    <div>
                        <h1 class:list={[
                            'font-mono font-bold text-4xl',
                            'text-text-color',
                            'transition-colors duration-300',
                            'max-sm:text-2xl'
                        ]}>
                            {t.title}
                        </h1>
                        <p class="text-lg opacity-70 font-mono">{t.subtitle}</p>
                    </div>
                </div>
                <p class:list={[
                    'text-lg leading-relaxed mt-6',
                    'text-text-color opacity-90'
                ]}>
                    {t.description}
                </p>

                <div class="flex flex-wrap gap-4 mt-6">
                    <a
                        href="https://github.com/jagobainda/LostieLauncher"
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                            'inline-flex items-center gap-2',
                            'bg-(--bg-primary) px-5 py-3 rounded-lg',
                            'text-text-color no-underline font-mono',
                            'hover:-translate-y-1 hover:shadow-[0_6px_12px_var(--shadow-dark)]',
                            'transition-all duration-300'
                        ]}
                    >
                        <i class="bi bi-github"></i>
                        GitHub
                    </a>
                    <a
                        href="https://ericlostie-launcher.jagoba.dev/public/installer/LostieLauncher-win-Setup.exe"
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                            'inline-flex items-center gap-2',
                            'bg-(--bg-primary) px-5 py-3 rounded-lg',
                            'text-text-color no-underline font-mono',
                            'hover:-translate-y-1 hover:shadow-[0_6px_12px_var(--shadow-dark)]',
                            'transition-all duration-300'
                        ]}
                    >
                        <i class="bi bi-download"></i>
                        {lang === 'es' ? 'Descargar instalador' : 'Download installer'}
                    </a>
                </div>
            </div>

            <section class:list={[
                'bg-(--bg-secondary) rounded-2xl p-8 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <h2 class:list={[
                    'font-mono font-bold text-3xl mb-6',
                    'text-text-color',
                    'max-sm:text-2xl',
                    'flex items-center gap-3'
                ]}>
                    <i class="bi bi-stack text-2xl text-blue-500"></i>
                    {t.techStack}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-purple-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-2">
                            <i class="bi bi-pc-display text-2xl text-purple-500"></i>
                            <span class="font-mono font-bold text-lg">WPF + .NET 10</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techWpf}</p>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-blue-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-2">
                            <i class="bi bi-diagram-3 text-2xl text-blue-500"></i>
                            <span class="font-mono font-bold text-lg">MVVM</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techMvvm}</p>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-green-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-2">
                            <i class="bi bi-box-seam text-2xl text-green-500"></i>
                            <span class="font-mono font-bold text-lg">DI Container</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techDI}</p>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-orange-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-2">
                            <i class="bi bi-file-earmark-zip text-2xl text-orange-500"></i>
                            <span class="font-mono font-bold text-lg">SharpCompress</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techSharpCompress}</p>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-cyan-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-2">
                            <i class="bi bi-arrow-repeat text-2xl text-cyan-500"></i>
                            <span class="font-mono font-bold text-lg">Velopack</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techVelopack}</p>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-pink-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-2">
                            <i class="bi bi-brush text-2xl text-pink-500"></i>
                            <span class="font-mono font-bold text-lg">IconPacks</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techIconPacks}</p>
                    </div>
                </div>
            </section>

            <section class:list={[
                'bg-(--bg-secondary) rounded-2xl p-8 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <h2 class:list={[
                    'font-mono font-bold text-3xl mb-6',
                    'text-text-color',
                    'max-sm:text-2xl',
                    'flex items-center gap-3'
                ]}>
                    <i class="bi bi-hdd-stack text-2xl text-orange-500"></i>
                    {t.infrastructure}
                </h2>
                <p class:list={[
                    'text-lg leading-relaxed mb-8',
                    'text-text-color opacity-90'
                ]}>
                    {t.infrastructureDesc}
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-l-4 border-yellow-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-1">
                            <i class="bi bi-list-ul text-xl text-yellow-500"></i>
                            <span class="font-mono font-bold">{t.infraCatalog}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraCatalogDesc}</div>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-l-4 border-blue-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-1">
                            <i class="bi bi-bell text-xl text-blue-500"></i>
                            <span class="font-mono font-bold">{t.infraNotifications}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraNotificationsDesc}</div>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-l-4 border-green-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-1">
                            <i class="bi bi-download text-xl text-green-500"></i>
                            <span class="font-mono font-bold">{t.infraInstaller}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraInstallerDesc}</div>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-l-4 border-purple-500'
                    ]}>
                        <div class="flex items-center gap-3 mb-1">
                            <i class="bi bi-arrow-repeat text-xl text-purple-500"></i>
                            <span class="font-mono font-bold">{t.infraUpdates}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraUpdatesDesc}</div>
                    </div>
                </div>
            </section>

            <section class:list={[
                'bg-(--bg-secondary) rounded-2xl p-8 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <h2 class:list={[
                    'font-mono font-bold text-3xl mb-6',
                    'text-text-color',
                    'max-sm:text-2xl',
                    'flex items-center gap-3'
                ]}>
                    <i class="bi bi-gear text-2xl text-green-500"></i>
                    {t.cicd}
                </h2>
                <p class:list={[
                    'text-lg leading-relaxed mb-8',
                    'text-text-color opacity-90'
                ]}>
                    {t.cicdDesc}
                </p>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class:list={[
                            'bg-(--bg-primary) p-5 rounded-xl text-center',
                            'border-t-4 border-blue-500'
                        ]}>
                            <i class="bi bi-hammer text-3xl text-blue-500 mb-2"></i>
                            <div class="font-mono font-bold">{t.cicdBuild}</div>
                            <div class="text-sm opacity-70 mt-1">{t.cicdBuildDesc}</div>
                        </div>
                        <div class:list={[
                            'bg-(--bg-primary) p-5 rounded-xl text-center',
                            'border-t-4 border-yellow-500'
                        ]}>
                            <i class="bi bi-shield-lock text-3xl text-yellow-500 mb-2"></i>
                            <div class="font-mono font-bold">{t.cicdSign}</div>
                            <div class="text-sm opacity-70 mt-1">{t.cicdSignDesc}</div>
                        </div>
                        <div class:list={[
                            'bg-(--bg-primary) p-5 rounded-xl text-center',
                            'border-t-4 border-purple-500'
                        ]}>
                            <i class="bi bi-box-seam text-3xl text-purple-500 mb-2"></i>
                            <div class="font-mono font-bold">{t.cicdPackage}</div>
                            <div class="text-sm opacity-70 mt-1">{t.cicdPackageDesc}</div>
                        </div>
                    </div>

                    <div class="flex justify-center py-2">
                        <div class:list={[
                            'flex flex-col items-center',
                            'text-text-color opacity-70'
                        ]}>
                            <i class="bi bi-arrow-down text-3xl"></i>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class:list={[
                            'bg-(--bg-primary) p-5 rounded-xl text-center',
                            'border-t-4 border-green-500'
                        ]}>
                            <i class="bi bi-github text-3xl text-green-500 mb-2"></i>
                            <div class="font-mono font-bold">{t.cicdRelease}</div>
                            <div class="text-sm opacity-70 mt-1">{t.cicdReleaseDesc}</div>
                        </div>
                        <div class:list={[
                            'bg-(--bg-primary) p-5 rounded-xl text-center',
                            'border-t-4 border-orange-500'
                        ]}>
                            <i class="bi bi-cloud-upload text-3xl text-orange-500 mb-2"></i>
                            <div class="font-mono font-bold">{t.cicdDeploy}</div>
                            <div class="text-sm opacity-70 mt-1">{t.cicdDeployDesc}</div>
                        </div>
                    </div>
                </div>
            </section>

            <section class:list={[
                'bg-(--bg-secondary) rounded-2xl p-8 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <h2 class:list={[
                    'font-mono font-bold text-3xl mb-6',
                    'text-text-color',
                    'max-sm:text-2xl',
                    'flex items-center gap-3'
                ]}>
                    <i class="bi bi-star text-2xl text-yellow-500"></i>
                    {t.features}
                </h2>
                <ul class="space-y-4">
                    {[
                        { icon: 'bi-collection', text: t.featureLibrary },
                        { icon: 'bi-cloud-arrow-down', text: t.featureDownloads },
                        { icon: 'bi-key', text: t.featureKeys },
                        { icon: 'bi-joystick', text: t.featureMyGames },
                        { icon: 'bi-arrow-repeat', text: t.featureUpdates },
                        { icon: 'bi-megaphone', text: t.featureNews },
                        { icon: 'bi-palette', text: t.featureThemes },
                        { icon: 'bi-translate', text: t.featureLanguages },
                        { icon: 'bi-window-desktop', text: t.featureTray },
                        { icon: 'bi-power', text: t.featureStartup },
                    ].map(feat => (
                        <li class:list={[
                            'flex items-center gap-3',
                            'bg-(--bg-primary) p-4 rounded-xl',
                            'text-text-color'
                        ]}>
                            <i class={`bi ${feat.icon} text-green-500 text-xl`}></i>
                            <span class="text-lg">{feat.text}</span>
                        </li>
                    ))}
                </ul>
            </section>

            <div class="mt-12 text-center space-y-6">
                <div class="flex justify-center gap-8 text-sm">
                    <a
                        href="https://jagoba.dev"
                        class:list={[
                            'text-text-color opacity-70',
                            'hover:opacity-100 transition-opacity',
                            'no-underline'
                        ]}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t.madeBy}
                    </a>
                    <a
                        href="mailto:contact@jagoba.dev"
                        class:list={[
                            'text-text-color opacity-50',
                            'hover:opacity-100 transition-opacity',
                            'no-underline'
                        ]}
                    >
                        contact@jagoba.dev
                    </a>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

