---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { projectStructuredData } from "../../lib/seo";

interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;
const homeUrl = lang === "en" ? "/en" : "/";

const contentEntry = await getEntry("project-details", `lostie-launcher-${lang}`);
const t = contentEntry!.data;

const jsonLd = projectStructuredData({
    lang,
    slug: "lostie-launcher",
    name: t.title,
    description: t.description!,
    sourceUrl: "https://github.com/jagobainda/LostieLauncher",
});
---

<BaseLayout title={`${t.title} - Jagoba Inda`} description={t.description!} showContactButton={false} jsonLd={jsonLd}>
    <div
        class:list={[
            "bg-bg-primary min-h-screen w-full",
            "transition-colors duration-300",
            "px-8 py-20",
            "max-sm:px-4 max-sm:py-16",
        ]}
    >
        <div class="mx-auto max-w-5xl">
            <a
                href={homeUrl}
                class:list={[
                    "mb-8 inline-flex items-center gap-2",
                    "text-text-color no-underline",
                    "transition-opacity duration-300 hover:opacity-70",
                    "font-mono text-lg",
                ]}
            >
                {t.backButton}
            </a>

            <div
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-10",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h1
                    class:list={[
                        "mb-2 font-mono text-5xl font-bold",
                        "text-text-color",
                        "transition-colors duration-300",
                        "max-sm:text-3xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:controller" />
                    {t.title}
                </h1>
                <p class:list={["mb-6 font-mono text-lg opacity-80", "text-text-color"]}>
                    {t.subtitle}
                </p>
                <p class:list={["mt-6 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.description}
                </p>

                <div class="mt-6 flex flex-wrap gap-4">
                    <a
                        href="https://github.com/jagobainda/LostieLauncher"
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                            "inline-flex items-center gap-2",
                            "rounded-lg bg-(--bg-primary) px-5 py-3",
                            "text-text-color font-mono no-underline",
                            "hover:-translate-y-1 hover:shadow-[0_6px_12px_var(--shadow-dark)]",
                            "transition-all duration-300",
                        ]}
                    >
                        <Icon name="bi:github" />
                        GitHub
                    </a>
                    <a
                        href="https://ericlostie-launcher.jagoba.dev/public/installer/LostieLauncher-win-Setup.exe"
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                            "inline-flex items-center gap-2",
                            "rounded-lg bg-(--bg-primary) px-5 py-3",
                            "text-text-color font-mono no-underline",
                            "hover:-translate-y-1 hover:shadow-[0_6px_12px_var(--shadow-dark)]",
                            "transition-all duration-300",
                        ]}
                    >
                        <Icon name="bi:download" />
                        {lang === "es" ? "Descargar instalador" : "Download installer"}
                    </a>
                </div>
            </div>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:stack" class="text-2xl text-blue-500" />
                    {t.techStack}
                </h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-purple-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <Icon name="bi:pc-display" class="text-2xl text-purple-500" />
                            <span class="font-mono text-lg font-bold">WPF + .NET 10</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techWpf}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-blue-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <Icon name="bi:diagram-3" class="text-2xl text-blue-500" />
                            <span class="font-mono text-lg font-bold">MVVM</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techMvvm}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-green-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <Icon name="bi:box-seam" class="text-2xl text-green-500" />
                            <span class="font-mono text-lg font-bold">DI Container</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techDI}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-orange-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <Icon name="bi:file-earmark-zip" class="text-2xl text-orange-500" />
                            <span class="font-mono text-lg font-bold">SharpCompress</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techSharpCompress}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-cyan-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <Icon name="bi:arrow-repeat" class="text-2xl text-cyan-500" />
                            <span class="font-mono text-lg font-bold">Velopack</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techVelopack}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-pink-500"]}>
                        <div class="mb-2 flex items-center gap-3">
                            <Icon name="bi:brush" class="text-2xl text-pink-500" />
                            <span class="font-mono text-lg font-bold">IconPacks</span>
                        </div>
                        <p class="text-sm opacity-80">{t.techIconPacks}</p>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:hdd-stack" class="text-2xl text-orange-500" />
                    {t.infrastructure}
                </h2>
                <p class:list={["mb-8 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.infrastructureDesc}
                </p>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-l-4 border-yellow-500"]}>
                        <div class="mb-1 flex items-center gap-3">
                            <Icon name="bi:list-ul" class="text-xl text-yellow-500" />
                            <span class="font-mono font-bold">{t.infraCatalog}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraCatalogDesc}</div>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-l-4 border-blue-500"]}>
                        <div class="mb-1 flex items-center gap-3">
                            <Icon name="bi:bell" class="text-xl text-blue-500" />
                            <span class="font-mono font-bold">{t.infraNotifications}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraNotificationsDesc}</div>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-l-4 border-green-500"]}>
                        <div class="mb-1 flex items-center gap-3">
                            <Icon name="bi:download" class="text-xl text-green-500" />
                            <span class="font-mono font-bold">{t.infraInstaller}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraInstallerDesc}</div>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-l-4 border-purple-500"]}>
                        <div class="mb-1 flex items-center gap-3">
                            <Icon name="bi:arrow-repeat" class="text-xl text-purple-500" />
                            <span class="font-mono font-bold">{t.infraUpdates}</span>
                        </div>
                        <div class="text-sm opacity-70">{t.infraUpdatesDesc}</div>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:gear" class="text-2xl text-green-500" />
                    {t.cicd}
                </h2>
                <p class:list={["mb-8 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.cicdDesc}
                </p>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-blue-500"]}
                        >
                            <Icon name="bi:hammer" class="mb-2 text-3xl text-blue-500" />
                            <div class="font-mono font-bold">{t.cicdBuild}</div>
                            <div class="mt-1 text-sm opacity-70">{t.cicdBuildDesc}</div>
                        </div>
                        <div
                            class:list={[
                                "rounded-xl bg-(--bg-primary) p-5 text-center",
                                "border-t-4 border-yellow-500",
                            ]}
                        >
                            <Icon name="bi:shield-lock" class="mb-2 text-3xl text-yellow-500" />
                            <div class="font-mono font-bold">{t.cicdSign}</div>
                            <div class="mt-1 text-sm opacity-70">{t.cicdSignDesc}</div>
                        </div>
                        <div
                            class:list={[
                                "rounded-xl bg-(--bg-primary) p-5 text-center",
                                "border-t-4 border-purple-500",
                            ]}
                        >
                            <Icon name="bi:box-seam" class="mb-2 text-3xl text-purple-500" />
                            <div class="font-mono font-bold">{t.cicdPackage}</div>
                            <div class="mt-1 text-sm opacity-70">{t.cicdPackageDesc}</div>
                        </div>
                    </div>

                    <div class="flex justify-center py-2">
                        <div class:list={["flex flex-col items-center", "text-text-color opacity-70"]}>
                            <Icon name="bi:arrow-down" class="text-3xl" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div
                            class:list={["rounded-xl bg-(--bg-primary) p-5 text-center", "border-t-4 border-green-500"]}
                        >
                            <Icon name="bi:github" class="mb-2 text-3xl text-green-500" />
                            <div class="font-mono font-bold">{t.cicdRelease}</div>
                            <div class="mt-1 text-sm opacity-70">{t.cicdReleaseDesc}</div>
                        </div>
                        <div
                            class:list={[
                                "rounded-xl bg-(--bg-primary) p-5 text-center",
                                "border-t-4 border-orange-500",
                            ]}
                        >
                            <Icon name="bi:cloud-upload" class="mb-2 text-3xl text-orange-500" />
                            <div class="font-mono font-bold">{t.cicdDeploy}</div>
                            <div class="mt-1 text-sm opacity-70">{t.cicdDeployDesc}</div>
                        </div>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:star" class="text-2xl text-yellow-500" />
                    {t.features}
                </h2>
                <ul class="space-y-4">
                    {
                        [
                            { icon: "bi:collection", text: t.featureLibrary },
                            { icon: "bi:cloud-arrow-down", text: t.featureDownloads },
                            { icon: "bi:key", text: t.featureKeys },
                            { icon: "bi:joystick", text: t.featureMyGames },
                            { icon: "bi:arrow-repeat", text: t.featureUpdates },
                            { icon: "bi:megaphone", text: t.featureNews },
                            { icon: "bi:palette", text: t.featureThemes },
                            { icon: "bi:translate", text: t.featureLanguages },
                            { icon: "bi:window-desktop", text: t.featureTray },
                            { icon: "bi:power", text: t.featureStartup },
                        ].map(feat => (
                            <li
                                class:list={[
                                    "flex items-center gap-3",
                                    "rounded-xl bg-(--bg-primary) p-4",
                                    "text-text-color",
                                ]}
                            >
                                <Icon name={feat.icon} class="text-xl text-green-500" />
                                <span class="text-lg">{feat.text}</span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <div class="mt-12 space-y-6 text-center">
                <div class="flex justify-center gap-8 text-sm">
                    <a
                        href="https://jagoba.dev"
                        class:list={[
                            "text-text-color opacity-70",
                            "transition-opacity hover:opacity-100",
                            "no-underline",
                        ]}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t.madeBy}
                    </a>
                    <a
                        href="mailto:contact@jagoba.dev"
                        class:list={[
                            "text-text-color opacity-50",
                            "transition-opacity hover:opacity-100",
                            "no-underline",
                        ]}
                    >
                        contact@jagoba.dev
                    </a>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
