---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { projectStructuredData } from "../../lib/seo";

interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;
const homeUrl = lang === "en" ? "/en" : "/";

const contentEntry = await getEntry("project-details", `benchmarks-${lang}`);
const t = contentEntry!.data;

const jsonLd = projectStructuredData({
    lang,
    slug: "benchmarks",
    name: t.title,
    description: t.description!,
    sourceUrl: "https://github.com/jagobainda/Benchmarks",
});

const accentMap: Record<string, string> = {
    purple: "border-purple-500 text-purple-500",
    cyan: "border-cyan-500 text-cyan-500",
    green: "border-green-500 text-green-500",
    pink: "border-pink-500 text-pink-500",
    orange: "border-orange-500 text-orange-500",
    blue: "border-blue-500 text-blue-500",
};
---

<BaseLayout title={`${t.title} - Jagoba Inda`} description={t.description!} showContactButton={false} jsonLd={jsonLd}>
    <div
        class:list={[
            "bg-bg-primary min-h-screen w-full",
            "transition-colors duration-300",
            "px-8 py-20",
            "max-sm:px-4 max-sm:py-16",
        ]}
    >
        <div class="mx-auto max-w-5xl">
            <!-- Back Button -->
            <a
                href={homeUrl}
                class:list={[
                    "mb-8 inline-flex items-center gap-2",
                    "text-text-color no-underline",
                    "transition-opacity duration-300 hover:opacity-70",
                    "font-mono text-lg",
                ]}
            >
                {t.backButton}
            </a>

            <div
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-10",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h1
                    class:list={[
                        "mb-2 font-mono text-5xl font-bold",
                        "text-text-color",
                        "transition-colors duration-300",
                        "max-sm:text-3xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:speedometer2" />
                    {t.title}
                </h1>
                <p class:list={["mb-6 font-mono text-lg opacity-80", "text-text-color"]}>
                    {t.subtitle}
                </p>
                <p class:list={["mb-4 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.description}
                </p>
                <div class="mt-6 flex flex-wrap gap-4">
                    <a
                        href="https://github.com/jagobainda/Benchmarks"
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                            "inline-flex items-center gap-2",
                            "rounded-lg bg-(--bg-primary) px-5 py-3",
                            "text-text-color font-mono no-underline",
                            "hover:-translate-y-1 hover:shadow-[0_6px_12px_var(--shadow-dark)]",
                            "transition-all duration-300",
                        ]}
                    >
                        <Icon name="bi:github" />
                        {t.sourceCode}
                    </a>

                </div>
                <div
                    class:list={[
                        "mt-4 rounded-xl p-4",
                        "bg-(--bg-primary)",
                        "border-l-4 border-yellow-500",
                        "flex items-start gap-3",
                    ]}
                >
                    <Icon name="bi:info-circle" class="mt-0.5 text-xl text-yellow-500" />
                    <p class="text-text-color opacity-90">{t.indexInfo}</p>
                </div>
            </div>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-4 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:diagram-3" class="text-2xl" />
                    {t.howItWorks}
                </h2>
                <p class:list={["mb-6 text-lg leading-relaxed", "text-text-color opacity-90"]}>
                    {t.howItWorksDesc}
                </p>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-purple-500"]}>
                        <div class="mb-2 flex items-center gap-2">
                            <Icon name="bi:cpu" class="text-2xl text-purple-500" />
                            <span class="font-mono font-bold">1. {t.flowStep1}</span>
                        </div>
                        <p class="text-text-color text-sm opacity-80">{t.flowStep1Desc}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-orange-500"]}>
                        <div class="mb-2 flex items-center gap-2">
                            <Icon name="bi:filetype-json" class="text-2xl text-orange-500" />
                            <span class="font-mono font-bold">2. {t.flowStep2}</span>
                        </div>
                        <p class="text-text-color text-sm opacity-80">{t.flowStep2Desc}</p>
                    </div>
                    <div class:list={["rounded-xl bg-(--bg-primary) p-5", "border-t-4 border-cyan-500"]}>
                        <div class="mb-2 flex items-center gap-2">
                            <Icon name="bi:globe" class="text-2xl text-cyan-500" />
                            <span class="font-mono font-bold">3. {t.flowStep3}</span>
                        </div>
                        <p class="text-text-color text-sm opacity-80">{t.flowStep3Desc}</p>
                    </div>
                </div>
            </section>

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2
                    class:list={[
                        "mb-6 font-mono text-3xl font-bold",
                        "text-text-color",
                        "max-sm:text-2xl",
                        "flex items-center gap-3",
                    ]}
                >
                    <Icon name="bi:collection" class="text-2xl" />
                    {t.subprojectsTitle}
                </h2>

                <div class="space-y-5">
                    {
                        t.benchmarkProjects?.map(project => {
                            const accent = accentMap[project.accent] ?? accentMap.purple;
                            const [borderClass, textClass] = accent.split(" ");
                            return (
                                <div class:list={["rounded-xl bg-(--bg-primary) p-6", "border-l-4", borderClass]}>
                                    <h3 class:list={["mb-2 font-mono text-xl font-bold", "flex items-center gap-2"]}>
                                        <Icon name={project.icon} class={textClass} />
                                        {project.name}
                                    </h3>
                                    <p class="text-text-color mb-4 opacity-80">{project.description}</p>
                                    <div class="mb-4 flex flex-wrap gap-2">
                                        {project.tags.map(tag => (
                                            <span
                                                class:list={[
                                                    "rounded-full bg-(--bg-secondary) px-3 py-1",
                                                    "font-mono text-sm",
                                                ]}
                                            >
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                    <div class="flex flex-wrap gap-3">
                                        <a
                                            href={project.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class:list={[
                                                "inline-flex items-center gap-2",
                                                "rounded-lg bg-(--bg-secondary) px-4 py-2",
                                                "text-text-color font-mono text-sm no-underline",
                                                "hover:-translate-y-1 hover:shadow-[0_4px_8px_var(--shadow-dark)]",
                                                "transition-all duration-300",
                                            ]}
                                        >
                                            <Icon name="bi:github" />
                                            {t.sourceCode}
                                        </a>
                                        {project.liveUrl && (
                                            <a
                                                href={project.liveUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class:list={[
                                                    "inline-flex items-center gap-2",
                                                    "rounded-lg bg-(--bg-secondary) px-4 py-2",
                                                    "text-text-color font-mono text-sm no-underline",
                                                    "hover:-translate-y-1 hover:shadow-[0_4px_8px_var(--shadow-dark)]",
                                                    "transition-all duration-300",
                                                ]}
                                            >
                                                <Icon name="bi:box-arrow-up-right" />
                                                {project.liveLabel ?? t.liveDemo}
                                            </a>
                                        )}
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>
            </section>

            <div class="mt-12 text-center">
                <div class="text-text-color text-sm opacity-50">
                    {t.madeBy}
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
