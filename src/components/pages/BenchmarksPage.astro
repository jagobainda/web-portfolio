---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

interface Props {
    lang: 'en' | 'es';
}

const { lang } = Astro.props;
const homeUrl = lang === 'en' ? '/en' : '/';

const contentEntry = await getEntry('project-details', `benchmarks-${lang}`);
const t = contentEntry!.data;

const accentMap: Record<string, string> = {
    purple: 'border-purple-500 text-purple-500',
    cyan: 'border-cyan-500 text-cyan-500',
    green: 'border-green-500 text-green-500',
    pink: 'border-pink-500 text-pink-500',
    orange: 'border-orange-500 text-orange-500',
    blue: 'border-blue-500 text-blue-500',
};
---

<BaseLayout title={`${t.title} - Jagoba Inda`} description={t.description!} showContactButton={false}>
    <div class:list={[
        'bg-bg-primary min-h-screen w-full',
        'transition-colors duration-300',
        'py-20 px-8',
        'max-sm:py-16 max-sm:px-4'
    ]}>
        <div class="max-w-5xl mx-auto">
            <!-- Back Button -->
            <a
                href={homeUrl}
                class:list={[
                    'inline-flex items-center gap-2 mb-8',
                    'text-text-color no-underline',
                    'hover:opacity-70 transition-opacity duration-300',
                    'font-mono text-lg'
                ]}
            >
                {t.backButton}
            </a>

            <div class:list={[
                'bg-(--bg-secondary) rounded-2xl p-10 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <h1 class:list={[
                    'font-mono font-bold text-5xl mb-2',
                    'text-text-color',
                    'transition-colors duration-300',
                    'max-sm:text-3xl',
                    'flex items-center gap-3'
                ]}>
                    <i class="bi bi-speedometer2"></i>
                    {t.title}
                </h1>
                <p class:list={[
                    'font-mono text-lg mb-6 opacity-80',
                    'text-text-color'
                ]}>
                    {t.subtitle}
                </p>
                <p class:list={[
                    'text-lg leading-relaxed mb-4',
                    'text-text-color opacity-90'
                ]}>
                    {t.description}
                </p>
                <div class:list={[
                    'mt-4 p-4 rounded-xl',
                    'bg-(--bg-primary)',
                    'border-l-4 border-yellow-500',
                    'flex items-start gap-3'
                ]}>
                    <i class="bi bi-info-circle text-yellow-500 text-xl mt-0.5"></i>
                    <p class="text-text-color opacity-90">{t.indexInfo}</p>
                </div>
            </div>

            <section class:list={[
                'bg-(--bg-secondary) rounded-2xl p-8 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <h2 class:list={[
                    'font-mono font-bold text-3xl mb-4',
                    'text-text-color',
                    'max-sm:text-2xl',
                    'flex items-center gap-3'
                ]}>
                    <i class="bi bi-diagram-3 text-2xl"></i>
                    {t.howItWorks}
                </h2>
                <p class:list={[
                    'text-lg leading-relaxed mb-6',
                    'text-text-color opacity-90'
                ]}>
                    {t.howItWorksDesc}
                </p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-purple-500'
                    ]}>
                        <div class="flex items-center gap-2 mb-2">
                            <i class="bi bi-cpu text-2xl text-purple-500"></i>
                            <span class="font-mono font-bold">1. {t.flowStep1}</span>
                        </div>
                        <p class="text-sm text-text-color opacity-80">{t.flowStep1Desc}</p>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-orange-500'
                    ]}>
                        <div class="flex items-center gap-2 mb-2">
                            <i class="bi bi-filetype-json text-2xl text-orange-500"></i>
                            <span class="font-mono font-bold">2. {t.flowStep2}</span>
                        </div>
                        <p class="text-sm text-text-color opacity-80">{t.flowStep2Desc}</p>
                    </div>
                    <div class:list={[
                        'bg-(--bg-primary) p-5 rounded-xl',
                        'border-t-4 border-cyan-500'
                    ]}>
                        <div class="flex items-center gap-2 mb-2">
                            <i class="bi bi-globe text-2xl text-cyan-500"></i>
                            <span class="font-mono font-bold">3. {t.flowStep3}</span>
                        </div>
                        <p class="text-sm text-text-color opacity-80">{t.flowStep3Desc}</p>
                    </div>
                </div>
            </section>

            <section class:list={[
                'bg-(--bg-secondary) rounded-2xl p-8 mb-8',
                'shadow-[4px_4px_12px_var(--shadow-light)]',
                'max-sm:p-6'
            ]}>
                <h2 class:list={[
                    'font-mono font-bold text-3xl mb-6',
                    'text-text-color',
                    'max-sm:text-2xl',
                    'flex items-center gap-3'
                ]}>
                    <i class="bi bi-collection text-2xl"></i>
                    {t.subprojectsTitle}
                </h2>

                <div class="space-y-5">
                    {t.benchmarkProjects?.map(project => {
                        const accent = accentMap[project.accent] ?? accentMap.purple;
                        const [borderClass, textClass] = accent.split(' ');
                        return (
                            <div class:list={[
                                'bg-(--bg-primary) p-6 rounded-xl',
                                'border-l-4',
                                borderClass
                            ]}>
                                <h3 class:list={[
                                    'font-mono font-bold text-xl mb-2',
                                    'flex items-center gap-2'
                                ]}>
                                    <i class={`${project.icon} ${textClass}`}></i>
                                    {project.name}
                                </h3>
                                <p class="text-text-color opacity-80 mb-4">{project.description}</p>
                                <div class="flex flex-wrap gap-2 mb-4">
                                    {project.tags.map(tag => (
                                        <span class:list={[
                                            'bg-(--bg-secondary) px-3 py-1 rounded-full',
                                            'font-mono text-sm'
                                        ]}>
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                                <div class="flex flex-wrap gap-3">
                                    <a
                                        href={project.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class:list={[
                                            'inline-flex items-center gap-2',
                                            'bg-(--bg-secondary) px-4 py-2 rounded-lg',
                                            'text-text-color no-underline font-mono text-sm',
                                            'hover:-translate-y-1 hover:shadow-[0_4px_8px_var(--shadow-dark)]',
                                            'transition-all duration-300'
                                        ]}
                                    >
                                        <i class="bi bi-github"></i>
                                        {t.sourceCode}
                                    </a>
                                    {project.liveUrl && (
                                        <a
                                            href={project.liveUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class:list={[
                                                'inline-flex items-center gap-2',
                                                'bg-(--bg-secondary) px-4 py-2 rounded-lg',
                                                'text-text-color no-underline font-mono text-sm',
                                                'hover:-translate-y-1 hover:shadow-[0_4px_8px_var(--shadow-dark)]',
                                                'transition-all duration-300'
                                            ]}
                                        >
                                            <i class="bi bi-box-arrow-up-right"></i>
                                            {project.liveLabel ?? t.liveDemo}
                                        </a>
                                    )}
                                </div>
                            </div>
                        );
                    })}
                </div>
            </section>

            <div class="mt-12 text-center space-y-6">
                <div class="flex justify-center gap-8 text-sm">
                    <a
                        href="https://github.com/jagobainda/Benchmarks"
                        class:list={[
                            'text-text-color opacity-70',
                            'hover:opacity-100 transition-opacity',
                            'no-underline inline-flex items-center gap-2'
                        ]}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <i class="bi bi-github"></i>
                        github.com/jagobainda/Benchmarks
                    </a>
                    <a
                        href="https://benchmarks.jagoba.dev"
                        class:list={[
                            'text-text-color opacity-70',
                            'hover:opacity-100 transition-opacity',
                            'no-underline inline-flex items-center gap-2'
                        ]}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <i class="bi bi-globe"></i>
                        benchmarks.jagoba.dev
                    </a>
                </div>
                <div class="text-sm text-text-color opacity-50">
                    {t.madeBy}
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

