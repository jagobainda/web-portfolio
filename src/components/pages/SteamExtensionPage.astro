---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { projectStructuredData } from "../../lib/seo";

interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;
const homeUrl = lang === "en" ? "/en" : "/";

const projectsEntry = await getEntry("projects", lang);
const projects = projectsEntry!.data;
const extensionProject = projects.personal.find(
    p => p.name === "Chrome Extension for CSWatch" || p.name === "Extensión de Chrome para CSWatch",
);

const contentEntry = await getEntry("project-details", `steam-extension-${lang}`);
const t = contentEntry!.data;

const jsonLd = projectStructuredData({
    lang,
    slug: "steam-profile-browser-extension",
    name: extensionProject?.name || t.title,
    description: extensionProject?.description || "",
});

let usageStats = null;
try {
    const response = await fetch("https://shapi.jagoba.dev/External/GetExtensionUsage");
    if (response.ok) usageStats = await response.json();
} catch (error) {
    console.error("Error fetching usage stats:", error);
}

const formatDate = (dateString: string | null | undefined): string => {
    if (!dateString) return "—";

    const dotIndex = dateString.indexOf(".");
    if (dotIndex !== -1) {
        const afterDot = dateString.slice(dotIndex + 1);
        const tzIndex = afterDot.search(/[+-Z]/);
        if (tzIndex > 3) dateString = dateString.slice(0, dotIndex + 4) + afterDot.slice(tzIndex);
    }

    const date = new Date(dateString);
    if (isNaN(date.getTime())) return dateString;

    return date.toLocaleString(lang, {
        year: "numeric",
        month: "long",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZoneName: "short",
    });
};
---

<BaseLayout
    title={`${extensionProject?.name || "Project"} - Jagoba Inda`}
    description={extensionProject?.description || ""}
    showContactButton={false}
    jsonLd={jsonLd}
>
    <div
        class:list={[
            "bg-bg-primary min-h-screen w-full",
            "transition-colors duration-300",
            "px-8 py-20",
            "max-sm:px-4 max-sm:py-16",
        ]}
    >
        <div class="mx-auto max-w-5xl">
            <a
                href={homeUrl}
                class:list={[
                    "mb-8 inline-flex items-center gap-2",
                    "text-text-color no-underline",
                    "transition-opacity duration-300 hover:opacity-70",
                    "font-mono text-lg",
                ]}
            >
                {t.backButton}
            </a>

            <div
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-10",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h1
                    class:list={[
                        "mb-4 font-mono text-5xl font-bold",
                        "text-text-color",
                        "transition-colors duration-300",
                        "max-sm:text-3xl",
                    ]}
                >
                    {extensionProject?.name}
                </h1>
                <p class:list={["text-xl leading-relaxed", "text-text-color opacity-90", "max-sm:text-lg"]}>
                    {extensionProject?.description}
                </p>

                <div class="mt-6 flex flex-wrap gap-4">
                    {
                        extensionProject?.links.map(link => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class:list={[
                                    "inline-flex items-center gap-2",
                                    "rounded-lg bg-(--bg-primary) px-5 py-3",
                                    "text-text-color font-mono no-underline",
                                    "hover:-translate-y-1 hover:shadow-[0_6px_12px_var(--shadow-dark)]",
                                    "transition-all duration-300",
                                ]}
                            >
                                <i class={link.icon} />
                                {link.text}
                            </a>
                        ))
                    }
                </div>
            </div>

            {
                usageStats && (
                    <section
                        class:list={[
                            "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                            "shadow-[4px_4px_12px_var(--shadow-light)]",
                            "max-sm:p-6",
                        ]}
                    >
                        <h2 class:list={["mb-6 font-mono text-3xl font-bold", "text-text-color", "max-sm:text-2xl"]}>
                            {t.usageStats}
                        </h2>
                        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                            <div class:list={["rounded-xl bg-(--bg-primary) p-6", "border-l-4 border-blue-500"]}>
                                <div class="mb-2 text-sm opacity-70">{t.avgDailyRequests3m}</div>
                                <div class="font-mono text-3xl font-bold">{usageStats.avgDailyRequests3m}</div>
                                <div class="mt-1 text-xs opacity-60">{t.requests}</div>
                            </div>

                            <div class:list={["rounded-xl bg-(--bg-primary) p-6", "border-l-4 border-purple-500"]}>
                                <div class="mb-2 text-sm opacity-70">{t.totalRequests3m}</div>
                                <div class="font-mono text-3xl font-bold">{usageStats.totalRequests3m}</div>
                                <div class="mt-1 text-xs opacity-60">{t.requests}</div>
                            </div>

                            <div class:list={["rounded-xl bg-(--bg-primary) p-6", "border-l-4 border-green-500"]}>
                                <div class="mb-2 text-sm opacity-70">{t.avgDailyRequests1m}</div>
                                <div class="font-mono text-3xl font-bold">{usageStats.avgDailyRequests1m}</div>
                                <div class="mt-1 text-xs opacity-60">{t.requests}</div>
                            </div>

                            <div class:list={["rounded-xl bg-(--bg-primary) p-6", "border-l-4 border-cyan-500"]}>
                                <div class="mb-2 text-sm opacity-70">{t.totalRequests1m}</div>
                                <div class="font-mono text-3xl font-bold">{usageStats.totalRequests1m}</div>
                                <div class="mt-1 text-xs opacity-60">{t.requests}</div>
                            </div>

                            <div
                                class:list={[
                                    "rounded-xl bg-(--bg-primary) p-6",
                                    `border-l-4 ${usageStats.requestsGrowthRateLastMonth >= 0 ? "border-green-500" : "border-red-500"}`,
                                ]}
                            >
                                <div class="mb-2 text-sm opacity-70">{t.requestsGrowthRate}</div>
                                <div class="flex items-center gap-2 font-mono text-3xl font-bold">
                                    {usageStats.requestsGrowthRateLastMonth >= 0 ? "+" : ""}
                                    {usageStats.requestsGrowthRateLastMonth.toFixed(1)}%
                                    <i
                                        class={`bi ${usageStats.requestsGrowthRateLastMonth >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right"} text-2xl`}
                                    />
                                </div>
                            </div>

                            <div class:list={["rounded-xl bg-(--bg-primary) p-6", "border-l-4 border-orange-500"]}>
                                <div class="mb-2 text-sm opacity-70">{t.maxRequestsInADay}</div>
                                <div class="font-mono text-3xl font-bold">{usageStats.maxRequestsInADay3m}</div>
                                <div class="mt-1 text-xs opacity-60">{t.requests}</div>
                            </div>
                        </div>
                        <div class="mt-6 text-center text-xs opacity-60">
                            {t.lastUpdated}: {formatDate(usageStats.lastUpdated)}
                        </div>
                    </section>
                )
            }

            <section
                class:list={[
                    "mb-8 rounded-2xl bg-(--bg-secondary) p-8",
                    "shadow-[4px_4px_12px_var(--shadow-light)]",
                    "max-sm:p-6",
                ]}
            >
                <h2 class:list={["mb-6 font-mono text-3xl font-bold", "text-text-color", "max-sm:text-2xl"]}>
                    {t.technologies}
                </h2>
                <div class="flex flex-wrap gap-3">
                    {
                        extensionProject?.tags.map(tag => (
                            <span
                                class:list={[
                                    "rounded-full bg-(--bg-primary) px-4 py-2",
                                    "font-mono text-base",
                                    "flex items-center gap-2",
                                ]}
                            >
                                <i class="bi bi-code-slash text-sm" />
                                {tag}
                            </span>
                        ))
                    }
                </div>
            </section>
        </div>
    </div>
</BaseLayout>
