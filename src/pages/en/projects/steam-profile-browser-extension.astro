---
export const prerender = false;

import SteamExtensionPage from '../../../components/pages/SteamExtensionPage.astro';

Astro.response.headers.set('Cache-Control', 'public, max-age=3600, must-revalidate');

const lang = (Astro.currentLocale === 'en' || Astro.currentLocale === 'es')
    ? Astro.currentLocale as 'en' | 'es'
    : 'en';
---

<SteamExtensionPage lang={lang} />
